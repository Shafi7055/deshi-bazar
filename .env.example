MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/bazardor?retryWrites=true&w=majority
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional OAuth credentials. Add the callback URLs shown in README.md to each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional catalog API overrides. The assignment APIs are used when these are unset.
BAZARDOR_API_URL=https://api.api-store.workers.dev/api/bazardor
BAZARDOR_API_FALLBACK_URL=https://api.abcz.workers.dev/api/bazardor
